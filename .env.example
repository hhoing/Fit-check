# ============================================================
# Fit Check — 환경변수 설정 예시
# 이 파일을 복사해서 .env.local 이름으로 저장 후 값을 채워주세요
# cp .env.example .env.local
# ============================================================

# Anthropic Claude API 키 (https://console.anthropic.com 에서 발급)
# 설정하지 않으면 더미 데이터로 동작합니다
ANTHROPIC_API_KEY=

# 사람인 채용 공고 API access-key
# https://oapi.saramin.co.kr/guide/job-search 에서 발급/확인
SARAMIN_ACCESS_KEY=

# Supabase DB 저장
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 고정 배포 주소 (Vercel preview 주소를 이 주소로 이동)
NEXT_PUBLIC_SITE_URL=https://hhoing-fit-check.vercel.app

# 출발지 주소 (통근 시간 계산 기준)
# 예: NEXT_PUBLIC_HOME_ADDRESS=서울시 강남구 테헤란로 1
NEXT_PUBLIC_HOME_ADDRESS=

# 네이버 지도 API (통근 시간 계산 시 필요)
# 네이버 클라우드 플랫폼 Maps > Geocoding, Directions 5 사용
# NAVER_MAP_CLIENT_ID=
# NAVER_MAP_CLIENT_SECRET=

# 카카오 REST API (통근 시간 실시간 연동 시 필요)
# https://developers.kakao.com 에서 발급
# KAKAO_REST_API_KEY=
